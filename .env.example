PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL (Neon). Certificates are verified unless DB_SSL_REJECT_UNAUTHORIZED=false (not recommended).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_REJECT_UNAUTHORIZED=true

# Firebase Admin (push notifications): service-account JSON on one line, or put serviceAccountKey.json next to server.js
FIREBASE_SERVICE_ACCOUNT=
