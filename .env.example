PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# Long random string (16+ characters), e.g. `openssl rand -hex 32`
JWT_SECRET=

# PostgreSQL. TLS is on for remote hosts and verified by default; DB_SSL=false for a local database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=varhub
DB_USER=postgres
DB_PASSWORD=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# Firebase Admin (push notifications): service-account JSON on one line, or serviceAccountKey.json next to server.js
FIREBASE_SERVICE_ACCOUNT=
